{
    "name": "Extension Hub",
    "short_name": "Extension Hub",
    "description": "Discover and browse GNOME Shell extensions. Search through thousands of extensions to customize your GNOME desktop.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
